# ---------------------------------------------------------------
# Jane Hirsch Website – Umgebungsvariablen (NIE ins Repository!)
# Kopieren nach .env.local (lokal) bzw. in die Hosting-Umgebung.
# ---------------------------------------------------------------

# Öffentliche Basis-URL (Canonicals, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Kontaktformular ---------------------------------------------
# Empfänger der Anfragen. Aus dem Bestand übernommen, MUSS vor
# Livebetrieb von Jane Hirsch bestätigt werden.
CONTACT_TO=info@hochzeitsstyling-jane.de
# Absender (muss zur SMTP-Domain passen, sonst SPF/DMARC-Probleme)
# Muss ein existierendes IONOS-Postfach der Domain sein (z. B. info@jane-hirsch.de),
# sonst lehnt IONOS den Versand ab bzw. SPF/DMARC schlagen fehl.
CONTACT_FROM="Website jane-hirsch.de <info@jane-hirsch.de>"

# SMTP. Solange SMTP_HOST leer ist, läuft das Formular im Trockenlauf:
# Validierung/Spam-Schutz arbeiten normal, es wird KEINE Mail versendet.
# IONOS (öffentlich dokumentiert): smtp.ionos.de, Port 587 (STARTTLS) bzw. 465 (SSL).
# SMTP_USER = vollständige IONOS-Postfachadresse, SMTP_PASS = Postfach-Passwort.
# Zugangsdaten NUR in .env.local / Hosting-Umgebung eintragen, nie ins Repository oder in den Chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Zusätzliche Sicherung: Versand nur, wenn explizit "true"
MAIL_SEND_ENABLED=false

# Geheimnis für das Formular-Token (Zeitsperre). Zufallswert, min. 32 Zeichen:
#   openssl rand -hex 32
FORM_SECRET=

# Rate-Limit: Anfragen pro Zeitfenster und IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900

# --- Online-Buchung (Stripe Checkout) ----------------------------
# Ohne STRIPE_SECRET_KEY antwortet /api/checkout mit 503 (Anfrage bleibt der Weg).
# Buchungs-Bereich auf den Angebotsseiten nur anzeigen, wenn "true" (Build-Variable!).
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# Zuerst IMMER Testmodus-Schlüssel (sk_test_…) – echte Zahlungen erst nach Abnahme.
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpunkts https://<domain>/api/stripe/webhook (Ereignis: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
CHECKOUT_RATE_MAX=10
CHECKOUT_RATE_WINDOW_SECONDS=900

# --- Backend (Anfragen & Bestellungen, /admin) ------------------
# Variante A – eigener Node-Server (IONOS, VPS): SQLite-Datei $DATA_DIR/jane.db.
#   Das Verzeichnis MUSS auf dem Hosting persistent sein (nicht bei jedem Deploy neu angelegt).
DATA_DIR=./data
# Variante B – Vercel/Serverless: gehostete libSQL-Datenbank (Turso). Dateien gehen dort verloren!
#   Die Vercel-Turso-Integration setzt TURSO_DATABASE_URL und TURSO_AUTH_TOKEN automatisch
#   (alternativ DATABASE_URL / DATABASE_AUTH_TOKEN). Region möglichst Frankfurt/EU.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# false = nichts speichern (Anfragen kommen dann nur per E-Mail)
STORE_ENABLED=true
# Passwort-Hash erzeugen mit: npm run admin:hash   (Passwort nie in Dateien/Chat schreiben)
ADMIN_PASSWORD_HASH=
# Optional eigener Schlüssel für die Backend-Sitzung (sonst FORM_SECRET), min. 32 Zeichen
ADMIN_SESSION_SECRET=
# Erledigte/Spam-Anfragen werden nach so vielen Tagen automatisch gelöscht
RETENTION_INQUIRY_DAYS=180

# Hinter einem Proxy die Client-IP für das Rate-Limit auslesen:
#   cloudflare = Cloudflare steht davor (CF-Connecting-IP; Server nur über Cloudflare erreichbar machen)
#   true       = anderer Reverse-Proxy, der X-Forwarded-For überschreibt
#   (leer)     = kein Proxy
TRUST_PROXY=

# Optional: Staging mit Zugriffsschutz nicht indexieren lassen ("true" = noindex)
SITE_NOINDEX=true
