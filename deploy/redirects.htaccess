# Apache-Variante der Weiterleitungen (erzeugt aus src/content/redirects.ts)
# Nur nötig, wenn die neue Seite hinter einem Apache/Proxy läuft, der nicht Next.js ist.
<IfModule mod_alias.c>
RedirectMatch 308 "^/our-services/?$" "/coaching"
RedirectMatch 308 "^/einzelcoaching1/?$" "/coaching/einzelcoaching"
RedirectMatch 308 "^/product/einzelcoaching-2/?$" "/coaching/einzelcoaching"
RedirectMatch 308 "^/gruppencoaching/?$" "/coaching/gruppencoaching"
RedirectMatch 308 "^/product/gruppencoaching/?$" "/coaching/gruppencoaching"
RedirectMatch 308 "^/saloncoaching/?$" "/coaching/saloncoaching"
RedirectMatch 308 "^/product/saloncoaching/?$" "/coaching/saloncoaching"
RedirectMatch 308 "^/watch-learn/?$" "/coaching/watch-and-learn"
RedirectMatch 308 "^/services/watch-learn/?$" "/coaching/watch-and-learn"
RedirectMatch 308 "^/product/watch-learn/?$" "/coaching/watch-and-learn"
RedirectMatch 308 "^/braut-make-up-coaching/?$" "/coaching/braut-make-up-coaching"
RedirectMatch 308 "^/product/braut-make-up-coaching/?$" "/coaching/braut-make-up-coaching"
RedirectMatch 308 "^/online-coaching/?$" "/coaching/online-coaching"
RedirectMatch 308 "^/product/online-coaching/?$" "/coaching/online-coaching"
RedirectMatch 308 "^/kontaktiere-mich/?$" "/kontakt"
RedirectMatch 308 "^/angebotsanfrage/?$" "/kontakt"
RedirectMatch 308 "^/privacy-policy/?$" "/datenschutz"
RedirectMatch 308 "^/shop/?$" "/coaching"
RedirectMatch 308 "^/warenkorb/?$" "/coaching"
RedirectMatch 308 "^/checkout/?$" "/coaching"
RedirectMatch 308 "^/my-account/?$" "/coaching"
RedirectMatch 308 "^/product(?:/\.*)?$" "/coaching"
RedirectMatch 308 "^/product-category(?:/\.*)?$" "/coaching"
RedirectMatch 308 "^/typography/?$" "/"
RedirectMatch 308 "^/evercompare/?$" "/coaching"
RedirectMatch 308 "^/luxury-beauty-salon-2/?$" "/"
RedirectMatch 308 "^/services(?:/\.*)?$" "/coaching"
</IfModule>
