# /srv/jane-hirsch/.env  – Umgebungsvariablen auf dem Server (nur root + Gruppe jane lesbar)
# Werte OHNE Anführungszeichen, außer der Hash. Nie in ein Repository oder in den Chat kopieren.

# Staging: SITE_NOINDEX=true und die Staging-URL. Zum Livegang: false und die echte Domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3110
SITE_NOINDEX=true

# Backend-Datenbank (Datei, persistent)
DATA_DIR=/srv/jane-hirsch/data
STORE_ENABLED=true
RETENTION_INQUIRY_DAYS=180

# Geheimnisse: FORM_SECRET mit  openssl rand -hex 32  erzeugen; Hash mit  npm run admin:hash
FORM_SECRET=
ADMIN_PASSWORD_HASH=

# Hinter nginx (überschreibt X-Forwarded-For) bzw. hinter Cloudflare: cloudflare
TRUST_PROXY=true

# Mail (IONOS) – erst nach Freigabe MAIL_SEND_ENABLED=true
CONTACT_TO=
CONTACT_FROM=
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_SEND_ENABLED=false

# Zahlung (Stripe) – zuerst nur Testmodus
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
